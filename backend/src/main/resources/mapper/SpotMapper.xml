<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.mapper.SpotMapper">
    <resultMap id="BaseResultMap" type="Spot">
        <id column="id" property="id"/>
        <result column="sample_id" property="sampleId"/>
        <result column="spot_name" property="spotName"/>
        <result column="x_coord" property="xCoord"/>
        <result column="y_coord" property="yCoord"/>
        <result column="consistency_score" property="consistencyScore"/>
        <result column="complexity_level" property="complexityLevel"/>
    </resultMap>

    <select id="findByDataId" resultMap="BaseResultMap">
        SELECT * FROM spot WHERE sample_id = #{dataId} ORDER BY spot_name
    </select>
</mapper>